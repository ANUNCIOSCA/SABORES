<?xml version="1.0" encoding="utf-8"?>
<!-- Al dejar presionado el ícono de la app aparece "Dictar": abre el micrófono directo -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.agendawa.app.VOICE"
            android:targetPackage="com.agendawa.app"
            android:targetClass="com.agendawa.app.MainActivity" />
    </shortcut>
</shortcuts>
